# Copy this file to .env and adjust if needed. Never commit .env.
# 127.0.0.1 and not 'localhost': on Windows 'localhost' tries IPv6 first and adds ~2 s per request.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3
EMBEDDING_MODEL=bge-m3
LLM_TIMEOUT_SECONDS=120
# Context window sent to the model, in tokens. The prompt is trimmed to fit it.
LLM_NUM_CTX=4096
# How long Ollama keeps the models loaded after the last request.
LLM_KEEP_ALIVE=30m
CHROMA_PATH=.cache/chroma
